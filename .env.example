# ---- Paths -----------------------------------------------------------
DATA_ROOT=~/data/market-making-sim           # required: data root inside the WSL ext4 filesystem, never /mnt/* (~ expanded by the settings loader)
MMS_DATA_ROOT=                               # optional: root for raw/, interim/, processed/; empty = DATA_ROOT
MMS_CLA_DATA_ROOT=~/data/crypto-lob-alpha    # required from M3: shared crypto capture (canonical book_l2/trades/instruments from crypto-lob-alpha, read-only)
MMS_SIGNAL_MODEL_DIR=../crypto-lob-alpha/artifacts/models  # required from M4: versioned signal artifacts
MMS_RESULTS_DIR=./results                    # optional: run outputs and experiment log (default ./results)
MMS_REPORTS_DIR=./reports                    # optional: figures and tables (default ./reports)

# ---- Simulator -------------------------------------------------------
MMS_SIM_BACKEND=fallback                     # optional: fallback | edbt (default fallback)
MMS_EDBT_PATH=                               # optional: local event-driven-backtester checkout if building edbt from source

# ---- Runtime ---------------------------------------------------------
MMS_LOG_LEVEL=INFO                           # optional: DEBUG | INFO | WARNING
MMS_N_JOBS=4                                 # optional: parallel worker processes for sweeps
MMS_TORCH_THREADS=4                          # optional: torch.set_num_threads for RL training

# ---- Paid data (only after D-01 approval) ----------------------------
TARDIS_API_KEY=                              # optional secret: empty = free first-day-of-month samples only
